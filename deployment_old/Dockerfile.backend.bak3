# deployment/Dockerfile.backend
FROM golang:1.24-alpine AS builder
WORKDIR /app

# Install build tools only if needed (git, ca-certificates)
RUN apk add --no-cache git ca-certificates build-base

# Copy go modules first for caching
COPY backend_go/go.mod backend_go/go.sum ./
RUN go mod download

# Copy full source
COPY backend_go/ ./

# Install sqlc tool idempotently (no-op if already present in GOPATH/bin)
RUN export GOBIN=/go/bin && \
    if ! command -v sqlc >/dev/null 2>&1; then \
      go install github.com/sqlc-dev/sqlc/cmd/sqlc@latest; \
    fi

# If sqlc.yaml exists, run sqlc generate (idempotent)
RUN if [ -f sqlc.yaml ]; then sqlc generate; else echo "sqlc.yaml not found, skipping generation"; fi

# Tidy and build strictly
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app/bin/backend ./cmd/server

# Final minimal runtime image
FROM alpine:latest
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/bin/backend /usr/local/bin/backend
EXPOSE 8083
CMD ["/usr/local/bin/backend"]
