		&video.ID, &video.Channel, &video.ChannelID, &video.Title,
		&video.URL, &video.Thumbnail, &video.Description, &video.VideoID,
		&video.PublishedAt, &video.Duration, &video.ViewCount,
		&video.LikeCount, &video.Category, &video.CreatedAt,
	)
	if err != nil {
		return nil, err
	}
	return &video, nil
}
