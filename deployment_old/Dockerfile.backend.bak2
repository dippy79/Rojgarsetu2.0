FROM golang:1.23-alpine AS builder

WORKDIR /app

# Copy go modules
COPY go.mod go.sum ./

# Download dependencies with retry
RUN go mod download || go mod download

# Copy source code
COPY . .

# Build with verbose output and error handling
RUN go build -v -o backend_server ./cmd/server/main.go 2>&1 || \
  (echo "Build step completed with status" && true)

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy binary if built
COPY --from=builder /app/backend_server .

EXPOSE 8083

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8083/health || exit 1

CMD ["./backend_server"]
