FROM golang:1.24-alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,direct

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.24.1

# 1. DEPENDENCY STEP
COPY go.mod go.sum ./
RUN go mod download

# 2. SOURCE CODE STEP
COPY . .
COPY migrations/ ./migrations/
COPY certs/ ./certs/

# 3. SYNC STEP (The Fix)
RUN go mod tidy

# 4. BUILD STEP
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w -X main.version=2.0.1" -o /usr/local/bin/backend_server ./cmd/server/main.go

# Final minimal runtime image - distroless static
FROM gcr.io/distroless/static-debian12:nonroot

# Switch to non-root user
USER 1000:1000

WORKDIR /app

# Copy only necessary files from builder
COPY --from=builder /usr/local/bin/backend_server .
COPY --from=builder /app/certs ./certs/
COPY --from=builder /app/migrations ./migrations/

# Health check on HTTPS health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8083/health || exit 1

EXPOSE 8083 8443

ENTRYPOINT ["/app/backend_server"]
