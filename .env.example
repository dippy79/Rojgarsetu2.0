# -----------------------------------------------------------------------------
# ROJGARSETU 2.0 - Environment Configuration Example
# Copy this file to .env and replace placeholders with real values.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
POSTGRES_USER=amitsharma
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD
POSTGRES_DB=rojgarsetu2

# --- Security & JWT ---
# Used for all microservices (Go, Java, Node)
# Generate a secure 32+ char string: openssl rand -base64 32
JWT_SECRET=YOUR_VERY_SECURE_JWT_SECRET
REFRESH_TOKEN_KEY=YOUR_SECURE_REFRESH_TOKEN_ENCRYPTION_KEY

# --- External APIs ---
# Required for YouTube Scraper (internal/videos/youtube.go)
YOUTUBE_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY

# Required for AI Engine (services/ai-engine-python)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Internal Service Auth (Step 3) ---
CRAWLER_ADMIN_KEY=YOUR_CRAWLER_ADMIN_API_KEY
AI_ENGINE_API_KEY=YOUR_AI_ENGINE_INTERNAL_KEY

# --- Networking ---
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001
API_GATEWAY_URL=http://localhost:3001

# --- Security & CSRF ---
CSRF_SECRET=YOUR_VERY_SECURE_CSRF_SECRET

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password
