# --- RojgarSetu 2.0 Backend Configuration ---
# REQUIRED: Database connection string
DATABASE_URL=postgres://user:pass@localhost:5432/dbname?sslmode=disable

# REQUIRED: Redis connection string (Standard Docker port 6379, Host port 6380)
REDIS_URL=redis://localhost:6380

# REQUIRED: Security Keys (Minimum 32 characters)
JWT_SECRET=YOUR_MIN_32_CHAR_SECRET_KEY_HERE
REFRESH_TOKEN_KEY=YOUR_MIN_32_CHAR_REFRESH_KEY_HERE

# OPTIONAL: Server configuration
PORT=8083
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# OPTIONAL: Mail server (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
