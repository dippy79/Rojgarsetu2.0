FROM postgres:15-alpine

ENV POSTGRES_USER=rojgarsetu
ENV POSTGRES_PASSWORD=rojgarsetu_secret
ENV POSTGRES_DB=rojgarsetu

COPY database/schema_v3.sql /docker-entrypoint-initdb.d/99_schema_v3.sql

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD pg_isready -U rojgarsetu -d rojgarsetu || exit 1
