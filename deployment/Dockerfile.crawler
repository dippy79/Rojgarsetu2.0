FROM golang:1.24-alpine AS builder
WORKDIR /app

RUN apk add --no-cache git ca-certificates build-base

# Copy only go.mod first for caching; go.sum may be generated by `go mod download`
# This avoids Docker build failures when go.sum is missing from the build context.
COPY go.mod ./
RUN go mod download

# Copy full source
# Copy full source
COPY . .

# Tidy
RUN go mod tidy

# Build strictly
# Change this:
RUN export GOBIN=/go/bin && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /app/bin/crawler ./cmd/scheduler

FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /root/
COPY --from=builder /app/bin/crawler .
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8082/health || exit 1
CMD ["./crawler"]
