# -----------------------------------------------------------------------------
# ROJGARSETU 2.0 - Production Environment Configuration Template
# Copy this file to .env and fill in the REQUIRED values.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Mandatory: Database connection string (e.g., postgres://user:pass@host:5432/dbname)
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=rojgarsetu2

# --- Caching (Redis) ---
# Mandatory: Redis connection string (e.g., redis://host:6379)
REDIS_URL=

# --- Security & JWT ---
# Mandatory: Secret for signing JWT tokens.
# REQUIREMENT: Minimum 64 characters random string.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Mandatory: Secret for refresh token encryption/signing.
# REQUIREMENT: Minimum 64 characters random string.
REFRESH_TOKEN_KEY=

# Mandatory: Secret for CSRF protection in API Gateway.
# REQUIREMENT: Minimum 64 characters random string.
CSRF_SECRET=

# Mandatory: Admin API key for crawler and protected internal tools.
ADMIN_API_KEY=

# --- Networking & CORS ---
# Mandatory: Comma-separated list of allowed origins (e.g., https://rojgarsetu.in)
# LOCALHOST IS STRRICTLY FORBIDDEN IN THIS FILE.
ALLOWED_ORIGINS=
CORS_ORIGINS=

# --- External APIs ---
# Mandatory: YouTube Data API v3 Key
YOUTUBE_API_KEY=

# Mandatory: Google Gemini AI API Key
GEMINI_API_KEY=

# --- Infrastructure ---
# Domain for WebSocket connections (e.g., api.rojgarsetu.in)
NEXT_PUBLIC_WS_HOST=
# Frontend API endpoint (e.g., https://api.rojgarsetu.in)
NEXT_PUBLIC_API_URL=

# --- Monitoring ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
