# ================================================================
# ROJGARSETU 2.0 — docker-compose.yml
# LOCATION: F:\Rojgarsetu2.0\rojgarsetu2\docker-compose.yml
# RUN FROM:  F:\Rojgarsetu2.0\rojgarsetu2\  (ROOT only)
# ================================================================

services:

  # ── DATABASE ──────────────────────────────────────────────────
  postgres:
    image: postgres:16-alpine
    container_name: rojgar-postgres
    restart: unless-stopped
    env_file: .env
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-amitsharma}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - rojgar-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── MIGRATIONS ────────────────────────────────────────────────
  migrate:
    image: migrate/migrate
    restart: on-failure
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./backend_go/migrations:/migrations
    command:
      - "-path"
      - "/migrations"
      - "-database"
      - "${DATABASE_URL}"
      - "up"
    networks:
      - rojgar-network

  # ── REDIS ─────────────────────────────────────────────────────
  redis:
    image: redis:7-alpine
    container_name: rojgar-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - rojgar-network

  # ── BACKEND (Go) ──────────────────────────────────────────────
  # backend_go/Dockerfile exists → apna dockerfile use karo
  backend:
    build:
      context: ./backend_go
      dockerfile: Dockerfile
    container_name: rojgar-backend
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    env_file: .env
    environment:
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: ${REDIS_URL}
      JWT_SECRET: ${JWT_SECRET}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      PORT: 8080
      ALLOWED_ORIGIN: ${ALLOWED_ORIGIN}
      ENV: production
    ports:
      - "8080:8080"
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    networks:
      - rojgar-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── API GATEWAY (Node.js) ─────────────────────────────────────
  # Dockerfile: deployment/Dockerfile.api-gateway
  api-gateway:
    build:
      context: ./services/api-gateway-node
      dockerfile: ../../deployment/Dockerfile.api-gateway
    container_name: rojgar-api-gateway
    restart: unless-stopped
    env_file: .env
    environment:
      NODE_ENV: production
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB}
      DB_USER: ${POSTGRES_USER}
      DB_PASSWORD: ${POSTGRES_PASSWORD}
      REDIS_URL: ${REDIS_URL}
      JWT_SECRET: ${JWT_SECRET}
    ports:
      - "3000:3000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      backend:
        condition: service_healthy
    networks:
      - rojgar-network
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── AUTH SERVICE (Java/Spring Boot) ───────────────────────────
  # Dockerfile: deployment/Dockerfile.auth-service
  auth-service:
    build:
      context: ./services/auth-java
      dockerfile: ../../deployment/Dockerfile.auth-service
    container_name: rojgar-auth-service
    restart: unless-stopped
    env_file: .env
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB}?sslmode=disable
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}
      JWT_SECRET: ${JWT_SECRET}
    ports:
      - "8081:8081"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - rojgar-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8081/actuator/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── CRAWLER (Go) ──────────────────────────────────────────────
  # Dockerfile: deployment/Dockerfile.crawler
  crawler-service:
    build:
      context: .
      dockerfile: deployment/Dockerfile.crawler
    container_name: rojgar-crawler-service
    restart: unless-stopped
    env_file: .env
    environment:
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: ${REDIS_URL}
    ports:
      - "8082:8082"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - rojgar-network
    shm_size: "1gb"
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8082/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── AI ENGINE (Python) ────────────────────────────────────────
  # Dockerfile: deployment/Dockerfile.ai-engine
  ai-engine:
    build:
      context: ./services/ai-engine-python
      dockerfile: ../../deployment/Dockerfile.ai-engine
    container_name: rojgar-ai-engine
    restart: unless-stopped
    env_file: .env
    environment:
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: ${REDIS_URL}
    ports:
      - "8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - ai_models:/app/models
    networks:
      - rojgar-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── FRONTEND (React) ──────────────────────────────────────────
  # Dockerfile: deployment/Dockerfile.frontend
  frontend:
    build:
      context: ./frontend
      dockerfile: ../deployment/Dockerfile.frontend
    container_name: rojgar-frontend
    restart: unless-stopped
    ports:
      - "3001:80"
    depends_on:
      api-gateway:
        condition: service_healthy
      backend:
        condition: service_healthy
    networks:
      - rojgar-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ── MONITORING ────────────────────────────────────────────────
  prometheus:
    image: prom/prometheus:latest
    container_name: rojgar-prometheus
    restart: unless-stopped
    volumes:
      - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    ports:
      - "9090:9090"
    networks:
      - rojgar-network

  grafana:
    image: grafana/grafana:latest
    container_name: rojgar-grafana
    restart: unless-stopped
    volumes:
      - grafana_data:/var/lib/grafana
      - ./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD}
    ports:
      - "3002:3000"
    depends_on:
      - prometheus
    networks:
      - rojgar-network

  # ── EXPORTERS ─────────────────────────────────────────────────
  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:v0.15.0
    container_name: rojgar-postgres-exporter
    restart: unless-stopped
    environment:
      DATA_SOURCE_NAME: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"
    ports:
      - "9187:9187"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - rojgar-network

  redis-exporter:
    image: oliver006/redis_exporter:v1.57.0
    container_name: rojgar-redis-exporter
    restart: unless-stopped
    command: --redis.addr redis:6379
    ports:
      - "9121:9121"
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - rojgar-network

networks:
  rojgar-network:
    driver: bridge

volumes:
  pgdata:
  redis_data:
  ai_models:
  prometheus_data:
  grafana_data: